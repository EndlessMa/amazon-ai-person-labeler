{
  "name": "amazon-ai-person-labeler",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "离线批量检测、添加和移除亚马逊 AI 生成人物 XMP 标签的桌面工具",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "node scripts/create-regression-fixtures.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "manifest": "node scripts/generate-release-manifest.mjs",
    "dist:mac:arm64": "pnpm build && electron-builder --mac zip --arm64 && pnpm manifest",
    "dist:mac:x64": "pnpm build && electron-builder --mac zip --x64 && pnpm manifest",
    "dist:win:x64": "node scripts/assert-windows-build-env.mjs && pnpm build && electron-builder --win portable --x64 && pnpm manifest"
  },
  "dependencies": {
    "7zip-bin-full": "26.2.1",
    "exiftool-vendored": "37.0.0",
    "fast-xml-parser": "5.10.1",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.internal.amazon-ai-person-labeler",
    "productName": "AI人物标签",
    "asar": true,
    "asarUnpack": [
      "node_modules/exiftool-vendored.pl/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/7zip-bin-full/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "regression-fixtures",
        "to": "regression-fixtures",
        "filter": [
          "**/*"
        ]
      }
    ],
    "forceCodeSigning": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": false
    }
  }
}
